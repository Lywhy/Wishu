{
  "name": "wishu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "preview": "vite preview",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "dev:server": "pnpm --filter @wishu/server dev",
    "build:server": "pnpm --filter @wishu/server build",
    "start:server": "pnpm --filter @wishu/server start",
    "typecheck:server": "pnpm --filter @wishu/server typecheck",
    "dev:all": "concurrently --kill-others --names UI,API \"pnpm dev\" \"pnpm dev:server\"",
    "db:init": "pnpm --filter @wishu/server db:init",
    "db:migrate": "pnpm --filter @wishu/server db:migrate",
    "db:seed": "pnpm --filter @wishu/server db:seed",
    "content:build": "node scripts/questions/build.mjs",
    "content:check": "node scripts/questions/check.mjs",
    "content:find": "node scripts/questions/find.mjs",
    "content:report": "node scripts/questions/report.mjs",
    "content:new": "node scripts/questions/new.mjs",
    "content:import": "node scripts/questions/import.mjs",
    "lint:ui": "oxlint src vite.config.ts",
    "typecheck:ui": "tsc -b --noEmit",
    "check:ui": "pnpm lint:ui && pnpm typecheck:ui",
    "lint:server": "oxlint server/src",
    "check:server": "pnpm lint:server && pnpm typecheck:server",
    "lint:content": "oxlint scripts/questions",
    "check:content": "pnpm lint:content && pnpm content:check",
    "check:all": "pnpm check:content && pnpm check:ui && pnpm check:server",
    "content:context": "node scripts/questions/context.mjs",
    "content:summary": "node scripts/questions/summary.mjs",
    "content:batch": "node scripts/questions/batch.mjs",
    "content:show": "node scripts/questions/show.mjs",
    "feedback:export": "pnpm --filter @wishu/server feedback:export",
    "lint:styles": "oxlint src"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.66.0",
    "monaco-editor": "0.55.1",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.18.1",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1",
    "scheduler": "^0.28.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "task-typescript": "npm:typescript@5.9.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@shadcn/lint": "^0.2.5",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "packageManager": "pnpm@12.11.2"
}
