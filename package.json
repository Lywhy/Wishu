{
  "name": "wishu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "preview": "vite preview",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "dev:server": "pnpm --filter @wishu/server dev",
    "build:server": "pnpm --filter @wishu/server build",
    "start:server": "pnpm --filter @wishu/server start",
    "typecheck:server": "pnpm --filter @wishu/server typecheck",
    "dev:all": "concurrently --kill-others --names UI,API \"pnpm dev\" \"pnpm dev:server\"",
    "db:init": "pnpm --filter @wishu/server db:init",
    "db:migrate": "pnpm --filter @wishu/server db:migrate",
    "db:seed": "pnpm --filter @wishu/server db:seed"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "packageManager": "pnpm@12.11.2"
}
