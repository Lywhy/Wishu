{
  "name": "@wishu/server",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsc-watch --project tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:init": "pnpm --dir .. content:check && pnpm build && node dist/database/cli.js init",
    "db:migrate": "pnpm build && node dist/database/cli.js migrate",
    "db:seed": "pnpm --dir .. content:check && pnpm build && node dist/database/cli.js seed",
    "feedback:export": "pnpm build && node dist/database/feedback-export.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.0",
    "tsc-watch": "^7.2.0",
    "typescript": "~5.9.3"
  }
}
